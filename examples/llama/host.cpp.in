// XRT host for the 3-CU SLR-split LLaMA decoder layer

#include <cstdint>
#include <cstdlib>
#include <fstream>
#include <iostream>
#include <string>
#include <vector>
#include <xrt/xrt_bo.h>
#include <xrt/xrt_device.h>
#include <xrt/xrt_kernel.h>

namespace {
std::vector<char> read_data(const std::string &path, size_t bytes) {
  std::vector<char> buf(bytes);
  std::ifstream f(path, std::ios::binary);
  if (!f) { std::cerr << "Failed to open input: " << path << "\n"; std::exit(1); }
  f.read(buf.data(), (std::streamsize)bytes);
  return buf;
}
void write_data(const std::string &path, const char *data, size_t bytes) {
  std::ofstream f(path, std::ios::binary);
  if (!f) { std::cerr << "Failed to open output: " << path << "\n"; std::exit(1); }
  f.write(data, (std::streamsize)bytes);
}
} // namespace

int main(int argc, char **argv) {
  if (argc != 2) { std::cerr << "Usage: " << argv[0] << " <xclbin>\n"; return 1; }
  auto device = xrt::device(0);
  auto uuid = device.load_xclbin(argv[1]);

  // @HOST_BODY@
  std::cout << "Finished execution!\n";
  return 0;
}

def sinh(value: Any, acc: Any = ...) -> Any: ...
def cosh(value: Any, acc: Any = ...) -> Any: ...
def tanh(value: Any, acc: Any = ...) -> Any: ...
def floor(value: Any, acc: Any = ...) -> Any: ...

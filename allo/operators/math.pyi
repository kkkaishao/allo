"""Typing stubs for elementwise math operators."""

from typing import Any

__all__ = [
    "exp",
    "exp2",
    "log",
    "log2",
    "abs",
    "pow",
    "sqrt",
    "rsqrt",
    "sin",
    "cos",
    "tan",
